# Mirrors smartpos-main/.env so the same keys mean the same things in both apps.
# Only the Supabase project, Razorpay keys and owner login differ. Keep this file
# free of real values; it is committed, .env.local is not.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only - never NEXT_PUBLIC_
SUPABASE_DB_URL=                    # for scripts/ and the SQL tests

# ── Razorpay ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                # server only
RAZORPAY_WEBHOOK_SECRET=            # server only, webhook HMAC

# ── Owner-only access (super_admin bootstrap allow-list) ─────────────────────
# Same pair shape as SmartPOS's ALTASOFTWARE_OWNER_LOGIN. The value is the login
# that is promoted to super_admin on first sign-in; the server-only name is read
# first and the NEXT_PUBLIC_ one is the fallback.
SMARTHELP_OWNER_LOGIN=wallmagazine89@gmail.com
NEXT_PUBLIC_SMARTHELP_OWNER_LOGIN=wallmagazine89@gmail.com

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=localhost
PROTOCOL=http
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Legacy alias for NEXT_PUBLIC_BASE_URL, still read as a fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                        # guards all /api/cron/*

# ── Email (all verification is by email for now) ────────────────────────────
# SMS is intentionally not configured: the phone channel is unused until an SMS
# provider exists, so SMS_PROVIDER_URL/SMS_API_KEY are not part of this file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=wallmagazine89@gmail.com
SMTP_PASS=                          # Gmail app password, not the account password
SMTP_FROM=wallmagazine89@gmail.com

# ── Defaults seeded into platform_settings on first run ─────────────────────
DEFAULT_CURRENCY=INR
DEFAULT_TAX_RATE=0.18
DEFAULT_COMMISSION_PCT=0.20
DEFAULT_PLATFORM_FEE=20
DEFAULT_SERVICE_OTP_LENGTH=4
DEFAULT_INSTANT_LEAD_MINUTES=30
DEFAULT_PHONE_COUNTRY_CODE=91

# ── Misc ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAP_STYLE_KEY=          # optional map tiles for the address picker
